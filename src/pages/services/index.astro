---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import BreathCTA from "../../components/BreathCTA.astro";
import { services } from "../../data/services";
---

<BaseLayout title="Services">
    <div class="pt-32 pb-16 px-6 text-center">
        <h1 class="text-5xl md:text-6xl font-serif text-ink mb-6">Our Menu</h1>
        <p class="text-muted max-w-xl mx-auto text-lg">
            A focused selection of treatments designed to restore balance.
        </p>
    </div>

    <section class="px-6 pb-24">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
            {services.map((service) => <ServiceCard service={service} />)}
        </div>
    </section>

    <BreathCTA
        title="Unsure what you need?"
        subtitle="Call us to discuss your specific recovery goals with a therapist."
        ctaText="Contact Us"
        ctaLink="../contact/"
    />
</BaseLayout>
