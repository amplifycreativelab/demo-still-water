---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GlassCard from "../../components/GlassCard.astro";
---

<BaseLayout title="Contact">
    <div class="min-h-screen pt-32 pb-16 px-6">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16">
            {/* Contact Info */}
            <div class="space-y-12">
                <div>
                    <h1 class="text-5xl md:text-6xl font-serif text-ink mb-8">
                        Visit Us.
                    </h1>
                    <p class="text-muted text-lg leading-relaxed max-w-md">
                        Built as a non-indexed portfolio concept, designed to
                        feel miles away from everything.
                    </p>
                </div>

                <div class="space-y-8">
                    <div>
                        <h3 class="font-serif text-2xl text-ink mb-4">
                            Location
                        </h3>
                        <address class="not-italic text-muted leading-relaxed">
                            128 Serenity Lane<br />
                            Riverside District<br />
                            <span class="text-sm opacity-60 mt-1 block"
                                >Fictional details for a portfolio demo.</span
                            >
                        </address>
                    </div>

                    <div>
                        <h3 class="font-serif text-2xl text-ink mb-4">
                            Open Hours
                        </h3>
                        <ul class="text-muted space-y-1">
                            <li
                                class="flex justify-between max-w-xs border-b border-pearl/40 pb-1"
                            >
                                <span>Mon - Fri</span>
                                <span>7am - 8pm</span>
                            </li>
                            <li
                                class="flex justify-between max-w-xs border-b border-pearl/40 pb-1 pt-2"
                            >
                                <span>Saturday</span>
                                <span>8am - 6pm</span>
                            </li>
                            <li
                                class="flex justify-between max-w-xs border-b border-pearl/40 pb-1 pt-2"
                            >
                                <span>Sunday</span>
                                <span>9am - 4pm</span>
                            </li>
                        </ul>
                    </div>

                    <div>
                        <h3 class="font-serif text-2xl text-ink mb-4">
                            Contact
                        </h3>
                        <p class="text-muted">
                            <a
                                href="https://amplifycreativelab.com"
                                target="_blank"
                                rel="nofollow noopener noreferrer"
                                class="hover:text-sage transition-colors"
                                >amplifycreativelab.com</a
                            >
                        </p>
                    </div>
                </div>
            </div>

            {/* Booking Form UI */}
            <div>
                <GlassCard class="p-8 md:p-10">
                    <h2 class="text-2xl font-serif text-ink mb-6">
                        Request Appointment
                    </h2>
                    <form class="space-y-6" onsubmit="event.preventDefault();">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label
                                    for="name"
                                    class="text-sm font-medium text-muted uppercase tracking-wider"
                                    >Name</label
                                >
                                <input
                                    type="text"
                                    id="name"
                                    class="w-full bg-stone-100/50 border border-stone-300 rounded-lg px-4 py-3 focus:border-sage focus:ring-1 focus:ring-sage transition-colors outline-none"
                                    placeholder="Jane Doe"
                                />
                            </div>
                            <div class="space-y-2">
                                <label
                                    for="email"
                                    class="text-sm font-medium text-muted uppercase tracking-wider"
                                    >Email</label
                                >
                                <input
                                    type="email"
                                    id="email"
                                    class="w-full bg-stone-100/50 border border-stone-300 rounded-lg px-4 py-3 focus:border-sage focus:ring-1 focus:ring-sage transition-colors outline-none"
                                    placeholder="jane@example.com"
                                />
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label
                                for="service"
                                class="text-sm font-medium text-muted uppercase tracking-wider"
                                >Service Preference</label
                            >
                            <select
                                id="service"
                                class="w-full bg-stone-100/50 border border-stone-300 rounded-lg px-4 py-3 focus:border-sage focus:ring-1 focus:ring-sage transition-colors outline-none"
                            >
                                <option>Precision Recovery Massage</option>
                                <option>Thermal Cycle Contrast Therapy</option>
                                <option>Sensory Deprivation Float</option>
                                <option>Consultation / Not Sure</option>
                            </select>
                        </div>

                        <div class="space-y-2">
                            <label
                                for="message"
                                class="text-sm font-medium text-muted uppercase tracking-wider"
                                >Notes</label
                            >
                            <textarea
                                id="message"
                                rows="3"
                                class="w-full bg-stone-100/50 border border-stone-300 rounded-lg px-4 py-3 focus:border-sage focus:ring-1 focus:ring-sage transition-colors outline-none"
                                placeholder="Preferred times, injuries, etc."
                            ></textarea>
                        </div>

                        <button
                            type="submit"
                            class="w-full py-4 bg-sage text-white font-medium rounded-full hover:bg-sage-dark transition-colors mt-4"
                        >
                            Request Times
                        </button>
                    </form>
                </GlassCard>
            </div>
        </div>
    </div>
</BaseLayout>
