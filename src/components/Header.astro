---
const links = [
    { href: "/services", label: "Services" },
    { href: "/about", label: "Studio" },
    { href: "/gift-vouchers", label: "Gifts" },
    { href: "/contact", label: "Book" },
];
---

<header
    class="py-8 px-6 md:px-12 w-full max-w-7xl mx-auto flex justify-between items-center transition-all duration-500"
>
    <a href="/" class="z-50 group">
        <div
            class="font-serif text-2xl tracking-tight text-ink group-hover:opacity-70 transition-opacity"
        >
            Stillwater.
        </div>
    </a>

    <nav class="hidden md:flex gap-8 items-center">
        {
            links.map((link) => (
                <a
                    href={
                        import.meta.env.BASE_URL.replace(/\/$/, "") + link.href
                    }
                    class="text-sm text-muted hover:text-ink transition-colors tracking-wide"
                >
                    {link.label}
                </a>
            ))
        }
    </nav>

    {/* Mobile Menu Toggle would go here - keeping minimal for now */}
    <button class="md:hidden text-ink p-2" aria-label="Menu">
        <span class="block w-5 h-px bg-current mb-1.5"></span>
        <span class="block w-5 h-px bg-current"></span>
    </button>
</header>
