---
const links = [
    { href: "/services", label: "Services" },
    { href: "/about", label: "Studio" },
    { href: "/gift-vouchers", label: "Gifts" },
    { href: "/contact", label: "Book" },
];
---

<header
    class="py-8 px-6 md:px-12 w-full max-w-7xl mx-auto flex justify-between items-center transition-all duration-500 relative z-50"
>
    <a href={import.meta.env.BASE_URL} class="z-50 group">
        <div
            class="font-serif text-2xl tracking-tight text-ink group-hover:opacity-70 transition-opacity"
        >
            Stillwater.
        </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex gap-8 items-center">
        {
            links.map((link) => (
                <a
                    href={
                        import.meta.env.BASE_URL.replace(/\/$/, "") + link.href
                    }
                    class="text-sm text-muted hover:text-ink transition-colors tracking-wide"
                >
                    {link.label}
                </a>
            ))
        }
    </nav>

    <!-- Mobile Menu Toggle -->
    <button
        id="mobile-menu-toggle"
        class="md:hidden text-ink p-2 relative z-50 w-10 h-10 flex flex-col justify-center items-center"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
    >
        <span
            class="menu-line menu-line-1 block w-5 h-[1.5px] bg-current transition-all duration-300 ease-out"
        ></span>
        <span
            class="menu-line menu-line-2 block w-5 h-[1.5px] bg-current transition-all duration-300 ease-out mt-1.5"
        ></span>
    </button>
</header>

<!-- Mobile Menu Overlay -->
<div
    id="mobile-menu"
    class="fixed inset-0 z-40 pointer-events-none"
    aria-hidden="true"
>
    <!-- Backdrop -->
    <div
        class="mobile-menu-backdrop absolute inset-0 bg-stone-100/95 backdrop-blur-xl opacity-0 transition-opacity duration-500"
    >
    </div>

    <!-- Menu Content -->
    <nav
        class="mobile-menu-content absolute inset-0 flex flex-col justify-center items-center opacity-0 translate-y-8 transition-all duration-500 delay-100"
    >
        <ul class="flex flex-col items-center gap-8">
            {
                links.map((link, index) => (
                    <li
                        class="mobile-menu-item opacity-0 translate-y-4 transition-all duration-400"
                        style={`transition-delay: ${150 + index * 75}ms`}
                    >
                        <a
                            href={
                                import.meta.env.BASE_URL.replace(/\/$/, "") +
                                link.href
                            }
                            class="font-serif text-4xl md:text-5xl text-ink hover:text-sage transition-colors duration-300"
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <!-- Decorative element -->
        <div
            class="mobile-menu-decor mt-16 w-12 h-px bg-sage/50 scale-x-0 transition-transform duration-700 delay-500"
        >
        </div>
    </nav>
</div>

<style>
    /* Menu Open State */
    .menu-open .menu-line-1 {
        transform: rotate(45deg) translateY(4px);
    }
    .menu-open .menu-line-2 {
        transform: rotate(-45deg) translateY(-4px);
    }

    #mobile-menu.is-open {
        pointer-events: auto;
    }

    #mobile-menu.is-open .mobile-menu-backdrop {
        opacity: 1;
    }

    #mobile-menu.is-open .mobile-menu-content {
        opacity: 1;
        transform: translateY(0);
    }

    #mobile-menu.is-open .mobile-menu-item {
        opacity: 1;
        transform: translateY(0);
    }

    #mobile-menu.is-open .mobile-menu-decor {
        transform: scaleX(1);
    }
</style>

<script>
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");

    if (toggle && menu) {
        toggle.addEventListener("click", () => {
            const isOpen = menu.classList.contains("is-open");

            if (isOpen) {
                // Close menu
                menu.classList.remove("is-open");
                toggle.classList.remove("menu-open");
                toggle.setAttribute("aria-expanded", "false");
                toggle.setAttribute("aria-label", "Open menu");
                menu.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
            } else {
                // Open menu
                menu.classList.add("is-open");
                toggle.classList.add("menu-open");
                toggle.setAttribute("aria-expanded", "true");
                toggle.setAttribute("aria-label", "Close menu");
                menu.setAttribute("aria-hidden", "false");
                document.body.style.overflow = "hidden";
            }
        });

        // Close menu when clicking on a link
        menu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
                menu.classList.remove("is-open");
                toggle.classList.remove("menu-open");
                toggle.setAttribute("aria-expanded", "false");
                toggle.setAttribute("aria-label", "Open menu");
                menu.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
            });
        });

        // Close menu on Escape key
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && menu.classList.contains("is-open")) {
                menu.classList.remove("is-open");
                toggle.classList.remove("menu-open");
                toggle.setAttribute("aria-expanded", "false");
                toggle.setAttribute("aria-label", "Open menu");
                menu.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
            }
        });
    }
</script>
