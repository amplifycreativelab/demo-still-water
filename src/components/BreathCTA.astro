---
import GlassCard from "./GlassCard.astro";

interface Props {
    title: string;
    subtitle?: string;
    ctaText: string;
    ctaLink: string;
}

const { title, subtitle, ctaText, ctaLink } = Astro.props;
---

<section class="py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
        <GlassCard class="inline-block w-full md:w-auto min-w-[300px] !p-12">
            <h2 class="text-3xl md:text-4xl text-ink font-serif mb-6">
                {title}
            </h2>
            {
                subtitle && (
                    <p class="text-muted text-lg mb-8 max-w-lg mx-auto">
                        {subtitle}
                    </p>
                )
            }
            <a
                href={ctaLink}
                class="inline-block px-8 py-3 bg-sage text-white rounded-full font-medium transition-all hover:bg-sage-dark focus-visible:ring-offset-2"
            >
                {ctaText}
            </a>
        </GlassCard>
    </div>
</section>
