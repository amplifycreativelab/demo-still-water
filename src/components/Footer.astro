---
const currentYear = new Date().getFullYear();
---

<footer class="mt-24 pt-16 pb-8 border-t border-pearl/50">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-12">
        <div class="col-span-1 md:col-span-1">
            <h3 class="font-serif text-xl mb-4 text-ink">Stillwater.</h3>
            <p class="text-sm text-muted leading-relaxed">
                Quiet recovery for the modern body and mind.
            </p>
        </div>

        <div>
            <h4
                class="text-xs uppercase tracking-widest text-sage mb-6 font-medium"
            >
                Visit
            </h4>
            <address class="not-italic text-sm text-muted space-y-2">
                <p>128 Serenity Lane</p>
                <p>Riverside District</p>
                <p class="pt-2">Open Daily: 7am - 8pm</p>
            </address>
        </div>

        <div>
            <h4
                class="text-xs uppercase tracking-widest text-sage mb-6 font-medium"
            >
                Contact
            </h4>
            <ul class="text-sm text-muted space-y-2">
                <li>
                    <a
                        href="https://amplifycreativelab.com"
                        target="_blank"
                        rel="nofollow noopener noreferrer"
                        class="hover:text-ink transition-colors"
                        >amplifycreativelab.com</a>
                </li>
            </ul>
        </div>

        <div>
            <h4
                class="text-xs uppercase tracking-widest text-sage mb-6 font-medium"
            >
                Connect
            </h4>
            <div class="flex gap-4">
                <a
                    href="#"
                    class="w-8 h-8 rounded-full border border-stone-300 flex items-center justify-center text-muted hover:border-ink hover:text-ink transition-all"
                    >IG</a
                >
                <a
                    href="#"
                    class="w-8 h-8 rounded-full border border-stone-300 flex items-center justify-center text-muted hover:border-ink hover:text-ink transition-all"
                    >FB</a
                >
            </div>
        </div>
    </div>

    <div
        class="max-w-7xl mx-auto px-6 mt-16 pt-8 border-t border-pearl/30 flex flex-col md:flex-row justify-between items-center text-xs text-muted/60"
    >
        <p>
            &copy; {currentYear} Stillwater Recovery Studio. All rights reserved.
        </p>
        <p class="mt-2 md:mt-0">Non-indexed concept demo.</p>
    </div>
</footer>
